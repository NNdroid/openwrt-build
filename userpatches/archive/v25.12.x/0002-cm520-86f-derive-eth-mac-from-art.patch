From: NNdroid <nnroid@users.noreply.github.com>
Date: Fri, 14 Nov 2026 09:30:00 +0800
Subject: [PATCH 2/4] ath79: CM520-86F derive eth MAC from art partition

eth1 (the only enabled GMAC, switch-only mode) had no MAC source, so the
kernel generated a random address on every boot. Read the factory MAC
from the art calibration partition (TP-Link layout, MAC at offset 0x0)
through nvmem cells, and point label-mac-device at the enabled node.

Signed-off-by: NNdroid <nnroid@users.noreply.github.com>
---
--- a/target/linux/ath79/dts/ar9344_caimore_cm520_86f.dts
+++ b/target/linux/ath79/dts/ar9344_caimore_cm520_86f.dts
@@ -9,7 +9,7 @@
 	compatible = "caimore,ar9344-cm520-86f", "qca,ar9344";
 
 	aliases {
-		label-mac-device = &eth0;
+		label-mac-device = &eth1;
 	};
 
 	keys {
@@ -53,10 +53,20 @@
 				reg = <0x020000 0xfd0000>;
 			};
 
-			partition@ff0000 {
+			art: partition@ff0000 {
 				label = "art";
 				reg = <0xff0000 0x010000>;
 				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					macaddr_art_0: macaddr@0 {
+						reg = <0x0 0x6>;
+					};
+				};
 			};
 		};
 	};
@@ -94,6 +104,9 @@
 &eth1 {
 	status = "okay";
 
+	nvmem-cells = <&macaddr_art_0>;
+	nvmem-cell-names = "mac-address";
+
 	gmac-config {
 		device = <&gmac>;
 		switch-only-mode = <1>;
